// ─────────────────────────────────────────────────────────────────────────────
// Conventions (see docs/conventions.md):
//  * UUID v7 primary keys (time-ordered → good B-tree locality)
//  * createdAt / updatedAt on every model; deletedAt on soft-deletable models
//  * snake_case table names via @@map, camelCase in code
//  * Index every foreign key and every column used in WHERE clauses
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PROVIDER
  ADMIN
}

/// Application user. Soft-deletable (see src/database/prisma.extension.ts).
model User {
  id            String  @id @default(uuid(7)) @db.Char(36)
  phone         String? @unique
  email         String? @unique
  /// null until the user completes their profile — phone/OTP signup collects
  /// no name up front
  name          String?
  /// JSON array of `Role` values — MySQL has no enum arrays. Narrowed back to
  /// Role[] at the auth boundary (see src/common/utils/roles.ts).
  roles         Json    @default("[\"USER\"]")
  /// ISO 639-1 code of the user's preferred app language
  language      String  @default("en")
  /// Loyalty points balance — earned by leaving reviews, redeemable via offers.
  rewardPoints  Int     @default(0)
  /// ELK Wallet balance. Top-up/withdraw and /payments/charge (wallet method)
  /// are the only things that move it — other verticals' "wallet" payment
  /// option is a mock charge today and doesn't yet debit this balance.
  walletBalance Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions           RefreshSession[]
  addresses          Address[]
  adOrdersPlaced     AdOrder[]           @relation("AdOrdersPlaced")
  adOrdersReceived   AdOrder[]           @relation("AdOrdersReceived")
  porterBookings     PorterBooking[]
  rideBookings       RideBooking[]
  reviews            Review[]
  notifications      Notification[]
  deviceTokens       DeviceToken[]
  ads                Ad[]
  adViews            AdView[]
  adWishlists        AdWishlist[]
  walletTransactions WalletTransaction[]
  providerProfile    ProviderProfile?

  @@index([deletedAt])
  @@map("users")
}

/// One row per device/login session. The raw refresh token is NEVER stored —
/// only its SHA-256 hash. `familyId` groups a rotation chain so that a
/// detected token reuse can revoke the whole chain at once.
model RefreshSession {
  id                  String    @id @default(uuid(7)) @db.Char(36)
  userId              String    @db.Char(36)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  familyId            String    @db.Char(36)
  userAgent           String?
  ip                  String?
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

/// A saved location (address book entry). `formattedAddress` and the
/// coordinates are resolved client-side (device maps SDK / GPS) — the
/// backend just stores whatever the client resolved, no server-side
/// geocoding. Soft-deletable (see src/database/prisma.extension.ts).
model Address {
  id               String  @id @default(uuid(7)) @db.Char(36)
  userId           String  @db.Char(36)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String
  formattedAddress String
  lat              Float
  lng              Float
  isDefault        Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([deletedAt])
  @@map("addresses")
}

// ═════════════════════════════════════════════════════════════════════════════
//  ELK Porter module
// ═════════════════════════════════════════════════════════════════════════════

enum PorterBookingStatus {
  CONFIRMED
  PICKED_UP
  DELIVERED
  CANCELLED
}

/// A delivery vehicle class (Bike / Car / Truck). Money is Decimal(10,2)
/// here — porter fares carry fils (₹3.50 fee, 5% VAT), unlike the
/// integer-priced verticals.
model PorterVehicle {
  id            String  @id @default(uuid(7)) @db.Char(36)
  /// stable wire id the app selects by, e.g. "bike"
  slug          String  @unique
  name          String
  /// legacy PorterVehicleModel renders `emoji`; the new cards use iconKey
  emoji         String
  iconKey       String
  capacityLabel String
  /// static arrival estimate until live dispatch exists
  etaMinutes    Int
  baseFare      Decimal @db.Decimal(10, 2)
  /// "FASTEST" | null — rendered verbatim by the app
  badge         String?
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings PorterBooking[]

  @@map("porter_vehicles")
}

/// Flat-priced booking add-ons (loading helper, fragile handling, insurance).
model PorterAddon {
  id        String  @id @default(uuid(7)) @db.Char(36)
  key       String  @unique
  label     String
  price     Decimal @db.Decimal(10, 2)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingAddons PorterBookingAddon[]

  @@map("porter_addons")
}

/// One porter delivery. Addresses are text snapshots (client-side geocoding
/// by decision); distance/ETA are static estimates until the maps layer
/// exists. Payment is a mock/internal charge until the payments module owns
/// real payment tables. Cancellation is a status, not a delete.
model PorterBooking {
  id            String              @id @default(uuid(7)) @db.Char(36)
  /// tracking id on the success screen, e.g. ELK-4821-QF
  code          String              @unique
  userId        String              @db.Char(36)
  user          User                @relation(fields: [userId], references: [id])
  vehicleId     String              @db.Char(36)
  vehicle       PorterVehicle       @relation(fields: [vehicleId], references: [id])
  status        PorterBookingStatus
  pickupAddress String
  dropAddress   String
  packageType   String?
  weightLabel   String?
  /// null = pick up now (ASAP); set = "schedule for later"
  scheduledAt   DateTime?
  /// display label of the chosen window, e.g. "9:00 – 10:00"
  pickupWindow  String?
  distanceKm    Decimal             @db.Decimal(6, 2)
  etaMinutes    Int

  baseFare    Decimal @db.Decimal(10, 2)
  addonsTotal Decimal @db.Decimal(10, 2)
  serviceFee  Decimal @db.Decimal(10, 2)
  vatAmount   Decimal @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)

  paymentMethod String
  paymentRef    String?
  paidAt        DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addons PorterBookingAddon[]

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@map("porter_bookings")
}

/// Add-ons chosen on a booking, price snapshotted at booking time — later
/// catalog price changes must not rewrite history.
model PorterBookingAddon {
  id        String        @id @default(uuid(7)) @db.Char(36)
  bookingId String        @db.Char(36)
  booking   PorterBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addonId   String        @db.Char(36)
  addon     PorterAddon   @relation(fields: [addonId], references: [id])
  label     String
  price     Decimal       @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, addonId])
  @@index([addonId])
  @@map("porter_booking_addons")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Rides (Taxi) module
// ═════════════════════════════════════════════════════════════════════════════

enum RideBookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A ride class (Auto / Economy / Premium / ELK XL). `baseFare` is the flat
/// fare for the default trip estimate — there's no live meter yet, so it
/// doubles as the total (matches the app's fixed per-class pricing).
model RideType {
  id              String  @id @default(uuid(7)) @db.Char(36)
  /// stable wire id the app selects by, e.g. "auto"
  slug            String  @unique
  name            String
  /// legacy RideTypeModel renders `emoji`; the new cards use iconKey (SVG)
  emoji           String
  iconKey         String
  seats           Int
  /// static arrival estimate until live dispatch exists
  etaMinutes      Int
  baseFare        Decimal @db.Decimal(10, 2)
  /// informational only — no cancellation charge is processed yet
  cancellationFee Decimal @db.Decimal(10, 2)
  /// "FASTER" | "POPULAR" | null — rendered verbatim by the app
  badge           String?
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings RideBooking[]

  @@map("ride_types")
}

/// One ride booking. Addresses are text snapshots (client-side geocoding by
/// decision); distance/ETA are static estimates until the maps layer exists.
/// Driver fields are a stub — plain snapshot strings, not a relation, until
/// a real driver/provider module exists (mirrors `Service.providerName`).
/// The OTP is shown to the rider to hand to the driver at pickup, then
/// verified server-side to start the trip. Payment is a mock/internal
/// charge until the payments module owns real payment tables.
model RideBooking {
  id         String            @id @default(uuid(7)) @db.Char(36)
  /// tracking id on the receipt, e.g. ELK-7GK2P4W
  code       String            @unique
  userId     String            @db.Char(36)
  user       User              @relation(fields: [userId], references: [id])
  rideTypeId String            @db.Char(36)
  rideType   RideType          @relation(fields: [rideTypeId], references: [id])
  status     RideBookingStatus @default(CONFIRMED)

  pickupAddress String
  dropAddress   String
  distanceKm    Decimal @db.Decimal(6, 2)
  etaMinutes    Int

  driverName   String
  vehicleLabel String
  plateNumber  String
  otpCode      String

  fare            Decimal @db.Decimal(10, 2)
  cancellationFee Decimal @db.Decimal(10, 2)
  tipAmount       Decimal @default(0) @db.Decimal(10, 2)
  ratingStars     Int?

  paymentMethod String
  paymentRef    String?
  paidAt        DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([rideTypeId])
  @@index([status])
  @@map("ride_bookings")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Reviews module
// ═════════════════════════════════════════════════════════════════════════════

/// A rating + review left on a completed home-services booking. One review
/// per booking (bookingId is unique). Submitting one recomputes the
/// service's `rating`/`reviewCount` aggregate — the seeded display values
/// on `Service` become real once reviews start arriving.
model Review {
  id String @id @default(uuid(7)) @db.Char(36)

  /// One review per order — unique, so an order cannot be rated twice.
  adOrderId String  @unique @db.Char(36)
  adOrder   AdOrder @relation(fields: [adOrderId], references: [id])

  userId  String @db.Char(36)
  user    User   @relation(fields: [userId], references: [id])
  rating  Int
  /// JSON array of quick-tag strings, e.g. ["On Time", "Professional"]
  tags    Json
  comment String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("reviews")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Notifications module
// ═════════════════════════════════════════════════════════════════════════════

/// An in-app notification (booking updates, payments, promos, rewards).
/// No per-item read state — the app only ever marks all of a user's
/// notifications read at once.
model Notification {
  id       String  @id @default(uuid(7)) @db.Char(36)
  userId   String  @db.Char(36)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// emoji shown in the tile, e.g. "🧹"
  icon     String
  /// ARGB tile background, e.g. 0xFFE0F7F5
  colorHex Int     @db.UnsignedInt
  title    String
  message  String  @db.Text
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

/// An FCM registration token for one install of the app.
///
/// `token` is unique across all users, not per user: handing a phone to
/// someone else re-registers the same token, and the row must move to the new
/// owner rather than leaving the previous one subscribed to their pushes.
///
/// Rows are deleted, never soft-deleted — a token FCM has rejected is dead and
/// keeping it only makes every later fan-out slower.
model DeviceToken {
  id       String         @id @default(uuid(7)) @db.Char(36)
  userId   String         @db.Char(36)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token    String         @unique @db.VarChar(255)
  platform DevicePlatform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Offers module
// ═════════════════════════════════════════════════════════════════════════════

/// A promotional banner on the Offers screen. `code` is display-only today
/// (no redemption wiring in the app) — the per-vertical promo tables
/// (CleanPromo, RepairPromo, RentalPromo) are what checkout actually applies.
model Offer {
  id               String  @id @default(uuid(7)) @db.Char(36)
  tagLabel         String
  title            String
  description      String
  code             String  @unique
  expiryLabel      String
  discountLabel    String
  discountSubLabel String
  /// ARGB gradient colors, e.g. 0xFF0D3D35
  gradientStartHex Int     @db.UnsignedInt
  gradientEndHex   Int     @db.UnsignedInt
  sortOrder        Int     @default(0)
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offers")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Wallet / Payments module
// ═════════════════════════════════════════════════════════════════════════════

/// A wallet activity line: top-ups/withdrawals (which move `User.walletBalance`)
/// and payment debits recorded for history regardless of the method actually
/// charged (mirrors the app's mixed wallet-history fixture).
model WalletTransaction {
  id       String  @id @default(uuid(7)) @db.Char(36)
  userId   String  @db.Char(36)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon     String
  title    String
  amount   Decimal @db.Decimal(10, 2)
  isCredit Boolean
  /// ARGB tile background, e.g. 0xFFD1FAE5
  colorHex Int     @db.UnsignedInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("wallet_transactions")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Orders module (chat + tracking over a home-services Booking)
// ═════════════════════════════════════════════════════════════════════════════

/// One chat message on a booking's order thread. `fromProvider` marks the
/// provider side (incoming in the app) vs the customer (outgoing); there is
/// no distinct provider identity yet, so the provider is represented by the
/// booking's seeded `service.providerName`. Delivered in realtime via the
/// /chat Socket.IO gateway and persisted here for history.
model ChatMessage {
  id String @id @default(uuid(7)) @db.Char(36)

  /// The order this thread belongs to. Deleting the order takes its messages
  /// with it — a thread with no job on the other end is not worth keeping.
  adOrderId String  @db.Char(36)
  adOrder   AdOrder @relation(fields: [adOrderId], references: [id], onDelete: Cascade)

  fromProvider Boolean
  text         String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adOrderId])
  @@map("chat_messages")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Provider module (second persona: dashboard, schedule, earnings, requests)
// ═════════════════════════════════════════════════════════════════════════════

enum ProviderStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// A service provider's business profile. Created by registration (PENDING),
/// then admin-verified (which grants the PROVIDER role). `isAvailable` is the
/// online toggle. Rating/earnings/job aggregates are stored display values
/// until a real jobs ledger exists (mirrors the seeded values on `Service`).
/// `scheduleDays` is a 7-element JSON array of booleans (Mon→Sun availability).
model ProviderProfile {
  id                   String         @id @default(uuid(7)) @db.Char(36)
  userId               String         @unique @db.Char(36)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName         String
  serviceCategory      String
  contactNumber        String
  serviceArea          String
  tradeLicenseUploaded Boolean        @default(false)
  idDocumentUploaded   Boolean        @default(false)
  status               ProviderStatus @default(PENDING)
  isAvailable          Boolean        @default(false)

  /// Mon→Sun availability, e.g. [true,true,false,true,true,false,false]
  scheduleDays Json @default("[true,true,true,true,true,false,false]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("provider_profiles")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Marketplace (seller ads)
// ═════════════════════════════════════════════════════════════════════════════

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
}

/// An order a buyer places against a seller's listing.
///
/// Deliberately separate from `Booking`, which belongs to the catalogue
/// services and has no seller: an ad is owned by a user, priced by them, and
/// fulfilled by them.
model AdOrder {
  id      String @id @default(uuid(7)) @db.Char(36)
  /// Human-facing reference shown to both sides, e.g. ELK-A-4T29K
  code    String @unique
  adId    String @db.Char(36)
  ad      Ad     @relation(fields: [adId], references: [id], onDelete: Restrict)
  buyerId String @db.Char(36)
  buyer   User   @relation("AdOrdersPlaced", fields: [buyerId], references: [id], onDelete: Cascade)

  /// Copied from the ad at order time rather than joined through it, so a
  /// listing that changes hands does not rewrite who was owed for past work.
  sellerId String @db.Char(36)
  seller   User   @relation("AdOrdersReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  status AdOrderStatus @default(NEW)

  /// What the buyer is charged in total — the listing's price × `quantity`,
  /// snapshotted because the seller may reprice the listing later.
  amount      Decimal @db.Decimal(10, 2)
  /// Units ordered — seats shampooed, rooms cleaned. One for a job priced per
  /// visit, which is most of them.
  quantity    Int     @default(1)
  /// Charges on top of `amount` that the buyer was shown: a supply fee, a
  /// call-out fee, a rental delivery. Without these the screen's total and the
  /// order's disagreed, and the order was the one that was wrong.
  feesAmount  Decimal @default(0) @db.Decimal(10, 2)
  /// Tax on `amount + feesAmount`. Separate from the fees so a receipt can
  /// show what it always showed.
  taxAmount   Decimal @default(0) @db.Decimal(10, 2)
  serviceName String

  scheduledAt    DateTime?
  /// End of a booked period: a rental's return, a stay's move-out. Null for
  /// one-off jobs, which are fully described by `scheduledAt` alone.
  endAt          DateTime?
  /// Stay reservations only — the agreed term, and the deposit taken up front
  /// on top of `amount`.
  durationMonths Int?
  depositAmount  Decimal?  @db.Decimal(10, 2)

  addressText  String
  /// Coordinate of `addressText`, when the buyer picked it on the map rather
  /// than typing it. Null for a hand-typed address; the tracking screen then
  /// shows the address without a map instead of centring on a guess.
  lat          Decimal? @db.Decimal(10, 7)
  lng          Decimal? @db.Decimal(10, 7)
  contactPhone String
  note         String?  @db.Text

  acceptedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatMessages ChatMessage[]
  review       Review?

  @@index([sellerId, status])
  @@index([buyerId])
  @@index([adId])
  @@map("ad_orders")
}

/// Lifecycle of an order a buyer places against a seller's ad.
enum AdOrderStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A seller's listing. "Best sellers" is these ads ranked by engagement, so
/// `viewCount` and `wishlistCount` are denormalised onto the row: the ranking
/// query has to sort on them, and counting AdView/AdWishlist rows per ad on
/// every home-screen load would not hold up.
///
/// The detail rows are still kept — they are what makes the counters
/// auditable, and what stops one user inflating a count by reloading.
model Ad {
  id           String   @id @default(uuid(7)) @db.Char(36)
  sellerId     String   @db.Char(36)
  seller       User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title        String
  description  String   @db.Text
  /// Reuses the home catalogue's category slugs (cleaning, laundry, ...).
  categorySlug String
  /// Emoji shown on the card until a seller uploads an image.
  ///
  /// No column default: MySQL stores an emoji default as `?` through the DDL
  /// Prisma writes, so an ad created without one rendered a broken glyph. The
  /// fallback lives in the service instead (DEFAULT_AD_ICON), and dropping the
  /// column default also stops every future migration re-emitting a MODIFY
  /// that never takes effect.
  icon         String
  price        Decimal  @db.Decimal(10, 2)
  /// "/ visit", "/ day", "starting" — display only.
  priceUnit    String   @default("")
  locality     String?
  city         String?
  /// Coordinate of `locality`, for the coverage map on the ad detail screen.
  /// Nullable: sellers type a locality, they do not drop a pin.
  lat          Float?
  lng          Float?
  /// Detail that only some categories have — seats/transmission/fuel on a
  /// rental, room type and monthly rent on a stay, duration on a clean.
  ///
  /// JSON rather than columns because the set differs per category and grows
  /// as categories are added; a column per field would leave the table wide
  /// and almost entirely null. The shape is validated per category at the API
  /// boundary, so nothing unvalidated reaches the row. The cost is that these
  /// fields cannot be filtered or sorted in SQL — if a category ever needs
  /// that (say "4+ seats"), it earns a real column.
  attributes   Json?
  status       AdStatus @default(ACTIVE)

  /// Maintained by the view/wishlist writes; never trusted from the client.
  viewCount     Int @default(0)
  wishlistCount Int @default(0)

  /// Denormalised from the reviews on this listing's completed orders, so a
  /// card can show a rating without aggregating on every read. Recomputed
  /// whole on each new review rather than nudged, so it cannot drift.
  /// Zero count means "no ratings yet", which the app shows as "New".
  ratingAverage Decimal @default(0) @db.Decimal(2, 1)
  ratingCount   Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images    AdImage[]
  views     AdView[]
  wishlists AdWishlist[]
  orders    AdOrder[]

  @@index([sellerId])
  @@index([status])
  @@index([categorySlug])
  /// Drives the "best sellers" ranking.
  @@index([status, wishlistCount, viewCount])
  @@index([deletedAt])
  @@map("ads")
}

/// An uploaded photo. `key` is the S3 object key from POST /uploads/image;
/// the URL is presigned on read and never stored.
model AdImage {
  id        String   @id @default(uuid(7)) @db.Char(36)
  adId      String   @db.Char(36)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  key       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([adId])
  @@map("ad_images")
}

/// One row per user per ad. The unique pair is what makes a view count
/// people rather than page loads — reopening an ad does not inflate it.
model AdView {
  id        String   @id @default(uuid(7)) @db.Char(36)
  adId      String   @db.Char(36)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([adId, userId])
  @@index([userId])
  @@map("ad_views")
}

/// A saved ad. Same unique pair, so wishlisting is idempotent.
model AdWishlist {
  id        String   @id @default(uuid(7)) @db.Char(36)
  adId      String   @db.Char(36)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([adId, userId])
  @@index([userId])
  @@map("ad_wishlists")
}
