// ─────────────────────────────────────────────────────────────────────────────
// Conventions (see docs/conventions.md):
//  * UUID v7 primary keys (time-ordered → good B-tree locality)
//  * createdAt / updatedAt on every model; deletedAt on soft-deletable models
//  * snake_case table names via @@map, camelCase in code
//  * Index every foreign key and every column used in WHERE clauses
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// The one role an account has. USER is a customer, and any user can also
/// sell from the seller panel (that switch is the app's, not a role); ADMIN is a company running cleaning/repair (its areas, its
/// professionals, the bookings in its areas). SUPER_ADMIN approves the
/// companies' new services, price changes and professionals.
enum UserType {
  USER
  ADMIN
  SUPER_ADMIN
}

/// A professional is offered for jobs only once the super admin approves them.
enum ProfessionalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WhatsappStatus {
  /// Accepted by WhatsApp Cloud API.
  SENT
  /// WhatsApp refused it, or could not be reached.
  FAILED
  /// WhatsApp sending is switched off (WHATSAPP_ENABLED=false); only logged.
  SKIPPED
}

/// The parts of ELK an admin runs. An ADMIN account holds one or more.
enum AdminModule {
  /// ELK Clean: cleaning services and their bookings.
  CLEAN
  /// ELK Repair: repair services and their bookings.
  REPAIR
  /// ELK Rental: rental listings on the marketplace, and seller verification.
  RENTAL
}

/// One module an admin can use. Set by the super admin with the ADMIN role.
model AdminModuleAccess {
  userId String      @db.Char(36)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  module AdminModule

  createdAt DateTime @default(now())

  @@id([userId, module])
  @@map("admin_module_access")
}

/// Application user. Soft-deletable (see src/database/prisma.extension.ts).
model User {
  id           String   @id @default(uuid(7)) @db.Char(36)
  phone        String?  @unique
  email        String?  @unique
  /// null until the user completes their profile — phone/OTP signup collects
  /// no name up front
  name         String?
  /// The account's role. The super admin sets ADMIN or SUPER_ADMIN from the
  /// Users tab; everyone else is USER.
  userType     UserType @default(USER)
  /// ISO 639-1 code of the user's preferred app language
  language     String   @default("en")
  /// Loyalty points balance — earned by leaving reviews, redeemable via offers.
  rewardPoints Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions             RefreshSession[]
  addresses            Address[]
  adOrdersPlaced       AdOrder[]              @relation("AdOrdersPlaced")
  adOrdersReceived     AdOrder[]              @relation("AdOrdersReceived")
  chatThreadsAsA       ChatThread[]           @relation("ChatThreadsAsA")
  chatThreadsAsB       ChatThread[]           @relation("ChatThreadsAsB")
  chatMessagesSent     ChatMessage[]          @relation("ChatMessagesSent")
  reviews              Review[]
  notifications        Notification[]
  deviceTokens         DeviceToken[]
  ads                  Ad[]
  adViews              AdView[]
  adWishlists          AdWishlist[]
  providerProfile      ProviderProfile?
  serviceBookings      ServiceBooking[]
  /// As a company (ADMIN): its professionals, areas and the bookings in them.
  companyProfessionals Professional[]         @relation("CompanyProfessionals")
  companyLocations     ServiceLocation[]      @relation("CompanyLocations")
  companyBookings      ServiceBooking[]       @relation("CompanyBookings")
  professionalsDecided Professional[]         @relation("ProfessionalsDecided")
  changesRequested     ServiceChangeRequest[] @relation("ChangesRequested")
  changesDecided       ServiceChangeRequest[] @relation("ChangesDecided")
  adminModules         AdminModuleAccess[]

  @@index([deletedAt])
  @@index([deletedAt, createdAt])
  @@map("users")
}

/// One row per device/login session. The raw refresh token is NEVER stored —
/// only its SHA-256 hash. `familyId` groups a rotation chain so that a
/// detected token reuse can revoke the whole chain at once.
model RefreshSession {
  id                  String    @id @default(uuid(7)) @db.Char(36)
  userId              String    @db.Char(36)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  familyId            String    @db.Char(36)
  userAgent           String?
  ip                  String?
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

/// A saved location (address book entry). `formattedAddress` and the
/// coordinates are resolved client-side (device maps SDK / GPS) — the
/// backend just stores whatever the client resolved, no server-side
/// geocoding. Soft-deletable (see src/database/prisma.extension.ts).
model Address {
  id               String  @id @default(uuid(7)) @db.Char(36)
  userId           String  @db.Char(36)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String
  formattedAddress String
  lat              Float
  lng              Float
  isDefault        Boolean @default(false)
  /// What the pin alone cannot say: which building, which door, how to find
  /// it. All optional — an address picked on the map still saves without them.
  building         String?
  flatNumber       String?
  directions       String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([deletedAt])
  @@map("addresses")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Reviews module
// ═════════════════════════════════════════════════════════════════════════════

/// A rating + review left on a completed home-services booking. One review
/// per booking (bookingId is unique). Submitting one recomputes the
/// service's `rating`/`reviewCount` aggregate — the seeded display values
/// on `Service` become real once reviews start arriving.
model Review {
  id String @id @default(uuid(7)) @db.Char(36)

  /// One review per order — unique, so an order cannot be rated twice.
  adOrderId String  @unique @db.Char(36)
  adOrder   AdOrder @relation(fields: [adOrderId], references: [id])

  userId  String @db.Char(36)
  user    User   @relation(fields: [userId], references: [id])
  rating  Int
  /// JSON array of quick-tag strings, e.g. ["On Time", "Professional"]
  tags    Json
  comment String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("reviews")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Notifications module
// ═════════════════════════════════════════════════════════════════════════════

/// An in-app notification (booking updates, payments, promos, rewards).
/// No per-item read state — the app only ever marks all of a user's
/// notifications read at once.
model Notification {
  id       String  @id @default(uuid(7)) @db.Char(36)
  userId   String  @db.Char(36)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// emoji shown in the tile, e.g. "🧹"
  icon     String
  /// ARGB tile background, e.g. 0xFFE0F7F5
  colorHex Int     @db.UnsignedInt
  title    String
  message  String  @db.Text
  isRead   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

/// An FCM registration token for one install of the app.
///
/// `token` is unique across all users, not per user: handing a phone to
/// someone else re-registers the same token, and the row must move to the new
/// owner rather than leaving the previous one subscribed to their pushes.
///
/// Rows are deleted, never soft-deleted — a token FCM has rejected is dead and
/// keeping it only makes every later fan-out slower.
model DeviceToken {
  id       String         @id @default(uuid(7)) @db.Char(36)
  userId   String         @db.Char(36)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token    String         @unique @db.VarChar(255)
  platform DevicePlatform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Offers module
// ═════════════════════════════════════════════════════════════════════════════

/// A promotional banner on the Offers screen. `code` is display-only today
/// (no redemption wiring in the app) — the per-vertical promo tables
/// (CleanPromo, RepairPromo, RentalPromo) are what checkout actually applies.
model Offer {
  id               String  @id @default(uuid(7)) @db.Char(36)
  tagLabel         String
  title            String
  description      String
  code             String  @unique
  expiryLabel      String
  discountLabel    String
  discountSubLabel String
  /// ARGB gradient colors, e.g. 0xFF0D3D35
  gradientStartHex Int     @db.UnsignedInt
  gradientEndHex   Int     @db.UnsignedInt
  sortOrder        Int     @default(0)
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offers")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Orders module (chat + tracking over a home-services Booking)
// ═════════════════════════════════════════════════════════════════════════════

/// One chat message on a booking's order thread. `fromProvider` marks the
/// provider side (incoming in the app) vs the customer (outgoing); there is
/// no distinct provider identity yet, so the provider is represented by the
/// booking's seeded `service.providerName`. Delivered in realtime via the
/// /chat Socket.IO gateway and persisted here for history.
/// A conversation between two accounts.
///
/// Chat used to hang off an order, which meant a buyer had to buy something —
/// or have a zero-value "enquiry" order invented for them — before they could
/// ask a question, and every new order started a conversation from scratch
/// beside the one that already had the messages in it. People talk to people.
///
/// The pair is stored sorted (`userAId < userBId`) so one row is found from
/// either side with a single lookup, and the unique constraint makes a
/// duplicate thread impossible rather than merely unlikely.
model ChatThread {
  id String @id @default(uuid(7)) @db.Char(36)

  userAId String @db.Char(36)
  userA   User   @relation("ChatThreadsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String @db.Char(36)
  userB   User   @relation("ChatThreadsAsB", fields: [userBId], references: [id], onDelete: Cascade)

  /// Denormalised so the inbox sorts without touching the messages table.
  lastMessageAt DateTime @default(now())

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@map("chat_threads")
}

model ChatMessage {
  id String @id @default(uuid(7)) @db.Char(36)

  /// The conversation this belongs to.
  threadId String     @db.Char(36)
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  /// Who wrote it. Replaces `fromProvider`, which recorded a role rather than
  /// a person and could not say which of two accounts had spoken.
  senderId String @db.Char(36)
  sender   User   @relation("ChatMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  text String @db.Text

  /// When the other side opened the thread and saw it. Null while unread,
  /// which is what the inbox badge counts.
  readAt DateTime?

  /// Legacy, write-once: the order a message predating account threads was
  /// sent against. Nothing reads it — `threadId` and `senderId` were
  /// backfilled from it — but it is the only record of what an old
  /// conversation was about, so it is kept rather than dropped. Safe to
  /// remove in a later migration.
  adOrderId String?  @db.Char(36)
  adOrder   AdOrder? @relation(fields: [adOrderId], references: [id], onDelete: SetNull)

  /// Legacy, superseded by `senderId`. It recorded a *role* — "the provider
  /// said this" — which could not name which of two accounts had spoken, and
  /// was the reason both sides saw the whole thread as their own.
  fromProvider Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId, createdAt])
  /// Counting what a reader has not seen yet, per thread.
  @@index([threadId, senderId, readAt])
  @@map("chat_messages")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Provider module (second persona: dashboard, schedule, earnings, requests)
// ═════════════════════════════════════════════════════════════════════════════

enum ProviderStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// A service provider's business profile. Created by registration (PENDING),
/// then admin-verified. `isAvailable` is the
/// online toggle. Rating/earnings/job aggregates are stored display values
/// until a real jobs ledger exists (mirrors the seeded values on `Service`).
/// `scheduleDays` is a 7-element JSON array of booleans (Mon→Sun availability).
model ProviderProfile {
  id                   String         @id @default(uuid(7)) @db.Char(36)
  userId               String         @unique @db.Char(36)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName         String
  serviceCategory      String
  contactNumber        String
  serviceArea          String
  tradeLicenseUploaded Boolean        @default(false)
  idDocumentUploaded   Boolean        @default(false)
  status               ProviderStatus @default(PENDING)
  isAvailable          Boolean        @default(false)

  /// Mon→Sun availability, e.g. [true,true,false,true,true,false,false]
  scheduleDays Json @default("[true,true,true,true,true,false,false]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("provider_profiles")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Marketplace (seller ads)
// ═════════════════════════════════════════════════════════════════════════════

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
}

/// An order a buyer places against a seller's listing.
///
/// Deliberately separate from `Booking`, which belongs to the catalogue
/// services and has no seller: an ad is owned by a user, priced by them, and
/// fulfilled by them.
model AdOrder {
  id      String @id @default(uuid(7)) @db.Char(36)
  /// Human-facing reference shown to both sides, e.g. ELK-A-4T29K
  code    String @unique
  adId    String @db.Char(36)
  ad      Ad     @relation(fields: [adId], references: [id], onDelete: Restrict)
  buyerId String @db.Char(36)
  buyer   User   @relation("AdOrdersPlaced", fields: [buyerId], references: [id], onDelete: Cascade)

  /// Copied from the ad at order time rather than joined through it, so a
  /// listing that changes hands does not rewrite who was owed for past work.
  sellerId String @db.Char(36)
  seller   User   @relation("AdOrdersReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  status AdOrderStatus @default(NEW)

  /// A question rather than a purchase: "is this still available", a request
  /// to view a room. Priced at zero and, unlike a real order, **reused** —
  /// tapping Chat a second time must reopen the same conversation, not start
  /// an empty one beside it.
  isEnquiry Boolean @default(false)

  /// What the buyer is charged in total — the listing's price × `quantity`,
  /// snapshotted because the seller may reprice the listing later.
  amount        Decimal @db.Decimal(10, 2)
  /// Units ordered — seats shampooed, rooms cleaned. One for a job priced per
  /// visit, which is most of them.
  quantity      Int     @default(1)
  /// Cleaning jobs only: how long the crew stays, how many come, and whether
  /// they bring the cleaning materials. The seller needs all three to turn up
  /// ready; `amount` and `feesAmount` are priced from them.
  hours         Int?
  professionals Int?
  withMaterials Boolean @default(false)
  /// Repair jobs only: the technician brings the spare parts, priced into
  /// `feesAmount`.
  withParts     Boolean @default(false)
  /// Charges on top of `amount` that the buyer was shown: a supply fee, a
  /// call-out fee, a rental delivery. Without these the screen's total and the
  /// order's disagreed, and the order was the one that was wrong.
  feesAmount    Decimal @default(0) @db.Decimal(10, 2)
  /// Tax on `amount + feesAmount`. Separate from the fees so a receipt can
  /// show what it always showed.
  taxAmount     Decimal @default(0) @db.Decimal(10, 2)
  /// How the buyer will pay: cash on service, for now. Null for an enquiry or
  /// an order from an older app.
  paymentMethod String? @db.VarChar(20)
  serviceName   String

  scheduledAt    DateTime?
  /// End of a booked period: a rental's return, a stay's move-out. Null for
  /// one-off jobs, which are fully described by `scheduledAt` alone.
  endAt          DateTime?
  /// Stay reservations only — the agreed term, and the deposit taken up front
  /// on top of `amount`.
  durationMonths Int?
  depositAmount  Decimal?  @db.Decimal(10, 2)

  addressText  String
  /// Coordinate of `addressText`, when the buyer picked it on the map rather
  /// than typing it. Null for a hand-typed address; the tracking screen then
  /// shows the address without a map instead of centring on a guess.
  lat          Decimal? @db.Decimal(10, 7)
  lng          Decimal? @db.Decimal(10, 7)
  contactPhone String
  note         String?  @db.Text

  acceptedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review       Review?
  /// Legacy link from before chat moved to account threads; see ChatMessage.
  chatMessages ChatMessage[]

  @@index([sellerId, status])
  @@index([buyerId])
  @@index([adId])
  /// Finding the buyer's existing conversation about a listing, on every tap
  /// of Chat.
  @@index([adId, buyerId, isEnquiry])
  @@map("ad_orders")
}

/// Lifecycle of an order a buyer places against a seller's ad.
enum AdOrderStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A seller's listing. "Best sellers" is these ads ranked by engagement, so
/// `viewCount` and `wishlistCount` are denormalised onto the row: the ranking
/// query has to sort on them, and counting AdView/AdWishlist rows per ad on
/// every home-screen load would not hold up.
///
/// The detail rows are still kept — they are what makes the counters
/// auditable, and what stops one user inflating a count by reloading.
model Ad {
  id           String   @id @default(uuid(7)) @db.Char(36)
  sellerId     String   @db.Char(36)
  seller       User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title        String
  description  String   @db.Text
  /// Reuses the home catalogue's category slugs (cleaning, laundry, ...).
  categorySlug String
  /// Emoji shown on the card until a seller uploads an image.
  ///
  /// No column default: MySQL stores an emoji default as `?` through the DDL
  /// Prisma writes, so an ad created without one rendered a broken glyph. The
  /// fallback lives in the service instead (DEFAULT_AD_ICON), and dropping the
  /// column default also stops every future migration re-emitting a MODIFY
  /// that never takes effect.
  icon         String
  price        Decimal  @db.Decimal(10, 2)
  /// "/ visit", "/ day", "starting" — display only.
  priceUnit    String   @default("")
  locality     String?
  city         String?
  /// Coordinate of `locality`, for the coverage map on the ad detail screen.
  /// Nullable: sellers type a locality, they do not drop a pin.
  lat          Float?
  lng          Float?
  /// Detail that only some categories have — seats/transmission/fuel on a
  /// rental, room type and monthly rent on a stay, duration on a clean.
  ///
  /// JSON rather than columns because the set differs per category and grows
  /// as categories are added; a column per field would leave the table wide
  /// and almost entirely null. The shape is validated per category at the API
  /// boundary, so nothing unvalidated reaches the row. The cost is that these
  /// fields cannot be filtered or sorted in SQL — if a category ever needs
  /// that (say "4+ seats"), it earns a real column.
  attributes   Json?
  status       AdStatus @default(ACTIVE)

  /// Maintained by the view/wishlist writes; never trusted from the client.
  viewCount     Int @default(0)
  wishlistCount Int @default(0)

  /// Denormalised from the reviews on this listing's completed orders, so a
  /// card can show a rating without aggregating on every read. Recomputed
  /// whole on each new review rather than nudged, so it cannot drift.
  /// Zero count means "no ratings yet", which the app shows as "New".
  ratingAverage Decimal @default(0) @db.Decimal(2, 1)
  ratingCount   Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  images    AdImage[]
  views     AdView[]
  wishlists AdWishlist[]
  orders    AdOrder[]

  @@index([sellerId])
  @@index([status])
  @@index([categorySlug])
  /// Drives the "best sellers" ranking.
  @@index([status, wishlistCount, viewCount])
  @@index([deletedAt])
  @@map("ads")
}

/// An uploaded photo. `key` is the S3 object key from POST /uploads/image;
/// the URL is presigned on read and never stored.
model AdImage {
  id        String   @id @default(uuid(7)) @db.Char(36)
  adId      String   @db.Char(36)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  key       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([adId])
  @@map("ad_images")
}

/// One row per user per ad. The unique pair is what makes a view count
/// people rather than page loads — reopening an ad does not inflate it.
model AdView {
  id        String   @id @default(uuid(7)) @db.Char(36)
  adId      String   @db.Char(36)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([adId, userId])
  @@index([userId])
  @@map("ad_views")
}

/// A saved ad. Same unique pair, so wishlisting is idempotent.
model AdWishlist {
  id        String   @id @default(uuid(7)) @db.Char(36)
  adId      String   @db.Char(36)
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([adId, userId])
  @@index([userId])
  @@map("ad_wishlists")
}

// ═════════════════════════════════════════════════════════════════════════════
//  Home services (cleaning, repair) — run by ELK, managed in the admin panel
// ═════════════════════════════════════════════════════════════════════════════

enum ServiceVertical {
  CLEANING
  REPAIR
}

/// A service ELK offers directly, priced by the hour. Unlike a seller's
/// listing, nobody owns it: the admin sets the price and assigns one of ELK's
/// own professionals to each booking.
///
/// Price = hourlyRate × hours + extraProRate × hours × (professionals − 1),
/// plus materialsFee when the customer asks for materials (spare parts, for
/// repair). "From" in the app is hourlyRate × minHours.
model HomeService {
  id           String          @id @default(uuid(7)) @db.Char(36)
  vertical     ServiceVertical
  /// The app tile it sits under — cln, bth, kit, … for cleaning; ac, plm, … for repair.
  category     String          @db.VarChar(20)
  name         String
  description  String          @db.Text
  minHours     Int
  hourlyRate   Decimal         @db.Decimal(10, 2)
  /// Per hour, for each professional after the first.
  extraProRate Decimal         @db.Decimal(10, 2)
  /// Cleaning materials, or spare parts for repair. Zero means not offered.
  materialsFee Decimal         @default(0) @db.Decimal(10, 2)
  /// Offered at all. An inactive service is also offline.
  active       Boolean         @default(false)
  /// Shown in the customer app.
  online       Boolean         @default(false)
  /// A new service stays hidden from the app until the super admin approves it.
  approved     Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings       ServiceBooking[]
  changeRequests ServiceChangeRequest[]

  @@index([vertical, active, online])
  @@map("home_services")
}

enum ServiceChangeKind {
  NEW_SERVICE
  PRICE_CHANGE
}

enum ServiceChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An admin's new service or price/duration change, waiting for the super
/// admin. The app keeps the live values until it is approved.
model ServiceChangeRequest {
  id        String              @id @default(uuid(7)) @db.Char(36)
  kind      ServiceChangeKind
  status    ServiceChangeStatus @default(PENDING)
  /// Null once the service is deleted; the snapshots keep the history readable.
  serviceId String?             @db.Char(36)
  service   HomeService?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// The service id while PENDING, null after: at most one open request per service.
  openFor   String?             @unique @db.Char(36)
  /// The live terms when decided; null for a new service.
  before    Json?
  requested Json

  requestedById String    @db.Char(36)
  requestedBy   User      @relation("ChangesRequested", fields: [requestedById], references: [id])
  decidedById   String?   @db.Char(36)
  decidedBy     User?     @relation("ChangesDecided", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  note          String    @default("") @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([decidedAt])
  @@index([serviceId])
  @@index([requestedById])
  @@index([decidedById])
  @@map("service_change_requests")
}

/// An area customers can book in. A booking is matched to the nearest active
/// area whose radius covers the address, or whose pincode the address carries.
model ServiceLocation {
  id        String  @id @default(uuid(7)) @db.Char(36)
  area      String
  district  String
  pincode   String  @db.VarChar(10)
  radiusKm  Int     @default(5)
  /// Centre of the area, geocoded when the admin saves it. Null when that
  /// failed, in which case only the pincode matches.
  lat       Float?
  lng       Float?
  active    Boolean @default(true)
  /// The company (ADMIN) serving this area. Null for an area nobody owns; it
  /// takes no bookings.
  companyId String? @db.Char(36)
  company   User?   @relation("CompanyLocations", fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings ServiceBooking[]

  @@index([companyId])
  @@map("service_locations")
}

/// One of ELK's own cleaners or technicians. Not an app account: the admin
/// assigns them to bookings and calls them.
/// Someone a company sends to do the work. Not an app account: they are told
/// about a job by WhatsApp. Phone and email are not unique, because one person
/// can work for two companies.
model Professional {
  id              String             @id @default(uuid(7)) @db.Char(36)
  companyId       String             @db.Char(36)
  company         User               @relation("CompanyProfessionals", fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  /// E.164, e.g. +919876543210. WhatsApp messages go here.
  phone           String             @db.VarChar(20)
  email           String             @db.VarChar(190)
  experienceYears Int                @default(0)
  status          ProfessionalStatus @default(PENDING)
  decidedById     String?            @db.Char(36)
  decidedBy       User?              @relation("ProfessionalsDecided", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  /// The super admin's reason, shown to the company when rejected.
  note            String             @default("") @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories       ProfessionalCategory[]
  bookings         ServiceBooking[]
  whatsappMessages WhatsappMessage[]

  @@index([companyId, status])
  @@index([status, createdAt])
  @@map("professionals")
}

/// A service tile a professional does, e.g. `bth` (bathroom) or `plm` (plumbing).
model ProfessionalCategory {
  professionalId String       @db.Char(36)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  category       String       @db.VarChar(20)

  @@id([professionalId, category])
  @@index([category])
  @@map("professional_categories")
}

/// Every WhatsApp sent to a professional about a job, sent or not.
model WhatsappMessage {
  id                String         @id @default(uuid(7)) @db.Char(36)
  bookingId         String         @db.Char(36)
  booking           ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  professionalId    String?        @db.Char(36)
  professional      Professional?  @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  toPhone           String         @db.VarChar(20)
  template          String         @db.VarChar(100)
  status            WhatsappStatus
  /// WhatsApp's message id (wamid…), when it was accepted.
  providerMessageId String?        @db.VarChar(200)
  error             String?        @db.Text
  /// The admin who pressed Assign or Resend.
  sentById          String         @db.Char(36)

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@map("whatsapp_messages")
}

/// A percentage discount a customer enters at checkout.
model PromoCode {
  id          String   @id @default(uuid(7)) @db.Char(36)
  code        String   @unique @db.VarChar(20)
  percent     Int
  /// The most it takes off, in rupees. Zero means no cap.
  maxDiscount Decimal  @default(0) @db.Decimal(10, 2)
  minOrder    Decimal  @default(0) @db.Decimal(10, 2)
  /// Last day it can be used, inclusive.
  validTill   DateTime @db.Date
  active      Boolean  @default(true)
  /// Internal note — who the code is for.
  description String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("promo_codes")
}

enum ServiceBookingStatus {
  /// Booked with Razorpay and not yet paid. Hidden from the customer's and the
  /// admin's lists; becomes PENDING once the payment is captured.
  AWAITING_PAYMENT
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A customer's booking of a [HomeService]. Arrives PENDING (or
/// AWAITING_PAYMENT until a Razorpay payment is captured) and is confirmed
/// when the admin assigns a professional. Prices are snapshotted: the admin
/// may reprice the service later.
model ServiceBooking {
  id     String @id @default(uuid(7)) @db.Char(36)
  /// Human-facing reference, e.g. ELK-S-4T29K.
  code   String @unique
  userId String @db.Char(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  serviceId     String?         @db.Char(36)
  service       HomeService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceName   String
  vertical      ServiceVertical
  category      String          @db.VarChar(20)
  hours         Int
  professionals Int
  withMaterials Boolean         @default(false)

  /// Calendar day (IST) and arrival window, e.g. 2026-10-02 / "11:00".
  scheduledDate DateTime @db.Date
  timeSlot      String   @db.VarChar(5)

  addressLabel String
  addressText  String           @db.VarChar(500)
  lat          Float?
  lng          Float?
  directions   String?          @db.Text
  contactPhone String           @db.VarChar(20)
  locationId   String?          @db.Char(36)
  location     ServiceLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// The company whose area the address fell in, when booked.
  companyId         String?       @db.Char(36)
  company           User?         @relation("CompanyBookings", fields: [companyId], references: [id], onDelete: SetNull)
  professionalId    String?       @db.Char(36)
  professional      Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  /// Copied on assignment, so history reads the same after a professional is removed.
  professionalName  String?       @db.VarChar(191)
  professionalPhone String?       @db.VarChar(20)

  status          ServiceBookingStatus @default(PENDING)
  baseAmount      Decimal              @db.Decimal(10, 2)
  materialsAmount Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal              @db.Decimal(10, 2)
  promoCode       String?              @db.VarChar(20)
  /// razorpay (card, apple or wallet on bookings made before Razorpay). Paid
  /// at checkout and refunded when cancelled, less any cancellation fee.
  paymentMethod   String               @default("razorpay") @db.VarChar(20)
  /// Kept from the refund when the customer cancels late. Zero otherwise.
  cancellationFee Decimal              @default(0) @db.Decimal(10, 2)

  confirmedAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  whatsappMessages WhatsappMessage[]
  payment          ServicePayment?

  @@index([userId])
  @@index([status, scheduledDate])
  @@index([professionalId])
  @@index([companyId, status])
  @@map("service_bookings")
}

enum ServicePaymentStatus {
  /// Razorpay order made; the customer has not paid yet.
  CREATED
  CAPTURED
  /// Refund asked of Razorpay; it settles to the customer's account later.
  REFUND_PENDING
  REFUNDED
}

/// The Razorpay payment for one [ServiceBooking]. Amounts are rupees, like the
/// booking's; Razorpay's paise exist only at the API boundary.
model ServicePayment {
  id        String         @id @default(uuid(7)) @db.Char(36)
  bookingId String         @unique @db.Char(36)
  booking   ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status            ServicePaymentStatus @default(CREATED)
  amount            Decimal              @db.Decimal(10, 2)
  razorpayOrderId   String               @unique @db.VarChar(40)
  razorpayPaymentId String?              @unique @db.VarChar(40)
  /// upi, card, netbanking, ... as Razorpay reports it once paid.
  method            String?              @db.VarChar(20)
  refundAmount      Decimal?             @db.Decimal(10, 2)
  razorpayRefundId  String?              @unique @db.VarChar(40)

  capturedAt DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("service_payments")
}
