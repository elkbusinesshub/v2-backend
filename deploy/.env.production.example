# Production environment for the EC2 deployment.
#
#   cp deploy/.env.production.example deploy/.env   &&   edit deploy/.env
#
# deploy/.env is gitignored. It is the api container's process environment and
# also supplies API_HOST_PORT to docker compose. Every variable is validated at
# boot (src/config/env.validation.ts) — the process refuses to start on a
# missing or malformed value.

# Host port nginx proxies to. Keep off 8000 — that is the existing app.
API_HOST_PORT=3000

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Origins allowed for CORS *and* the Socket.IO handshake. Must include the
# real scheme+host the mobile app / web client calls. No trailing slash.
CORS_ORIGINS=https://api.example.com

# ─── Database (RDS) ──────────────────────────────────────────────────────────
# The RDS writer endpoint, not localhost. Copy it from the RDS console —
# it looks like elk-prod.abc123xyz.ap-south-1.rds.amazonaws.com
# URL-encode any of : / ? # [ ] @ in the password.
DATABASE_URL=mysql://elk:CHANGE_ME_db_password@CHANGE_ME.ap-south-1.rds.amazonaws.com:3306/elk
# If you turn on `require_secure_transport` in the RDS parameter group, append
# ?sslaccept=strict to the URL above. Off by default; traffic stays in the VPC.

# ─── Redis ───────────────────────────────────────────────────────────────────
# `redis` is the compose service name — the container on this host.
REDIS_URL=redis://redis:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# At least 32 chars, and NOT the development secret. Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
# MUST stay empty. A fixed-code phone is a permanent unauthenticated login;
# the app refuses to boot if this is non-empty while NODE_ENV=production.
OTP_TEST_PHONES=
OTP_TEST_CODE=123456

# ─── SMS (Sangamam Online FastSMS) ───────────────────────────────────────────
# true in production, otherwise real users never receive an OTP.
SMS_ENABLED=true
SMS_ACCESS_TOKEN=CHANGE_ME
SMS_ACCESS_TOKEN_KEY=CHANGE_ME
SMS_SENDER_ID=SGMOLN
SMS_COUNTRY_CODE=+91

# ─── Admin allowlist ─────────────────────────────────────────────────────────
# Comma-separated E.164 phones granted ADMIN on login. There is no seeded
# admin, so leaving this empty makes the admin routes unreachable.
ADMIN_PHONES=

# ─── Rate limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ─── Storage (S3) ────────────────────────────────────────────────────────────
S3_REGION=ap-south-1
S3_BUCKET=elk-storage-bucket
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Prefer an EC2 instance role over static keys — attach a role with
# s3:GetObject/PutObject/DeleteObject on the bucket and leave these empty,
# the AWS SDK picks the role up from instance metadata automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Places / geocoding ──────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=CHANGE_ME
PLACES_REGION_CODE=IN

# ─── Push notifications (FCM) ────────────────────────────────────────────────
# The path is inside the container. Put the JSON at deploy/secrets/ on the
# host — compose mounts that directory read-only at /app/secrets.
# Set PUSH_ENABLED=false until the file is in place.
PUSH_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# ─── Observability / docs ────────────────────────────────────────────────────
LOG_LEVEL=info
# Swagger is force-disabled when NODE_ENV=production regardless of this flag.
SWAGGER_ENABLED=false
