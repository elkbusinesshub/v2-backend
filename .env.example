# ─── App ─────────────────────────────────────────────────────────────────────
# development | test | staging | production
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins for CORS and Socket.IO
CORS_ORIGINS=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# matches docker-compose (host port 3307); root is needed locally so
# `prisma migrate dev` can create its shadow database
DATABASE_URL=mysql://root:elk@localhost:3307/elk

# ─── Redis ───────────────────────────────────────────────────────────────────
# matches docker-compose (host port 6380)
REDIS_URL=redis://localhost:6380

# ─── Auth ────────────────────────────────────────────────────────────────────
# MUST be at least 32 chars. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# ─── OTP (phone login) ───────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
# Comma-separated E.164 phones that always get OTP_TEST_CODE and are never sent
# an SMS. For QA on a real handset. The app refuses to boot if this is set while
# NODE_ENV=production.
OTP_TEST_PHONES=
OTP_TEST_CODE=123456

# ─── SMS (Sangamam Online FastSMS) ───────────────────────────────────────────
# false → the OTP is only printed to the server log (local dev default).
# true  → SMS_ACCESS_TOKEN and SMS_ACCESS_TOKEN_KEY become required.
SMS_ENABLED=false
SMS_ACCESS_TOKEN=
SMS_ACCESS_TOKEN_KEY=
# Registered sender header and the country code the gateway dials
SMS_SENDER_ID=SGMOLN
SMS_COUNTRY_CODE=+91

# ─── Admin allowlist ─────────────────────────────────────────────────────────
# Comma-separated E.164 phones granted ADMIN on login. There is no seeded admin
# account, so without at least one entry the admin routes are unreachable.
ADMIN_PHONES=

# ─── Rate limiting (global default) ──────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ─── Storage (S3-compatible) ─────────────────────────────────────────────────
S3_REGION=me-central-1
S3_BUCKET=elk-dev
# Set for MinIO/localstack; leave empty for real AWS
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Leave empty in production — use IAM task roles instead of static keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Places / geocoding (Google Maps Platform) ───────────────────────────────
# Needs the Geocoding API and Places API (New) enabled on the key.
# Empty → /places returns 502 instead of proxying a request that would fail.
GOOGLE_MAPS_API_KEY=
# ISO 3166-1 alpha-2 autocomplete bias
PLACES_REGION_CODE=IN

# ─── Push notifications (Firebase Cloud Messaging) ───────────────────────────
# Disabled → notifications are still stored and listed, they just do not reach
# the device. Mount the service-account JSON as a secret; never commit it.
PUSH_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# ─── Observability / docs ────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Swagger UI is force-disabled in production regardless of this flag
SWAGGER_ENABLED=true
